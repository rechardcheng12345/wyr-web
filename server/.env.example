# Copy to server/.env and fill in. In production set these as real environment variables
# instead; they override this file. Business settings (shipping rates, order hold time,
# WhatsApp number, ...) are not here: they live in src/constants.ts.

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=wyr_app
DB_PASSWORD=
DB_NAME=wyr_website

PORT=4000

# dev/development = frontend served by Vite (npm start). Anything else (e.g. production):
# Express serves the built client/dist itself (npm run build).
NODE_ENV=development

# Public URL of the site (where buyers browse; /api must be reachable under it).
# Used for the ToyyibPay return URL (<PUBLIC_BASE_URL>/checkout/return) and
# callback URL (<PUBLIC_BASE_URL>/api/payments/toyyibpay/callback). Must be reachable
# from the internet for ToyyibPay callbacks; localhost only works with PAYMENT_MODE=mock.
PUBLIC_BASE_URL="http://localhost:5173"

# toyyibpay = real ToyyibPay (needs the keys below); mock = fake payment page for local testing
PAYMENT_MODE=toyyibpay
# Sandbox: https://dev.toyyibpay.com   Live: https://toyyibpay.com
TOYYIBPAY_BASE_URL="https://dev.toyyibpay.com"
TOYYIBPAY_SECRET_KEY=""
TOYYIBPAY_CATEGORY_CODE=""

# Admin portal (/system) login. Defaults to admin / admin123 when unset: set real values in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Signs the admin session cookie. Any long random string; if unset, sessions end on every restart.
SESSION_SECRET=""

# BigSeller open API (src/integrations/bigseller.js). Leave commented out: the integration stays disabled.
# BIGSELLER_APP_KEY=""
# BIGSELLER_APP_SECRET=""
