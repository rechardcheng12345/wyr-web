# Copy to server/.env and fill in. MySQL 8.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/wyr_website"
PORT=4000
# Comma-separated list of allowed browser origins for the API
CORS_ORIGIN="http://localhost:5173"

# Public URL of the site (where buyers browse; /api must be reachable under it).
# Used for the ToyyibPay return URL (<PUBLIC_BASE_URL>/checkout/return) and
# callback URL (<PUBLIC_BASE_URL>/api/payments/toyyibpay/callback). Must be reachable
# from the internet for ToyyibPay callbacks; localhost only works with PAYMENT_MODE=mock.
PUBLIC_BASE_URL="http://localhost:5173"

# Flat shipping in RM: Peninsular Malaysia, and East Malaysia (Sabah, Sarawak, Labuan)
SHIPPING_FLAT_WM=8
SHIPPING_FLAT_EM=15

# WhatsApp number for "Bulk / business quote" links on product pages (shown from 50 pieces).
# Digits with country code, no + or spaces. Placeholder: replace with the real business number.
WHATSAPP_NUMBER=60123456789

# How long an unpaid order holds its stock, in minutes
ORDER_HOLD_MINUTES=30

# toyyibpay = real ToyyibPay (needs the keys below); mock = fake payment page for local testing
PAYMENT_MODE=toyyibpay
# Sandbox: https://dev.toyyibpay.com   Live: https://toyyibpay.com
TOYYIBPAY_BASE_URL="https://dev.toyyibpay.com"
TOYYIBPAY_SECRET_KEY=""
TOYYIBPAY_CATEGORY_CODE=""
# 0 = FPX only, 1 = card only, 2 = both (card must be enabled on the account)
TOYYIBPAY_PAYMENT_CHANNEL=0
