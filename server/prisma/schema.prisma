// Translated from _handoff/wyr-website/schema.sql (draft v0.1). Table and column
// names are mapped 1:1 so the generated SQL matches the original draft.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // Built at runtime from DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME by src/env.js; not set by hand.
  url      = env("DATABASE_URL")
}

// WYR Technology, WYR Virtual Concept
model Store {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)
  products Product[]

  @@map("stores")
}

model Category {
  id       Int        @id @default(autoincrement())
  parentId Int?       @map("parent_id")
  name     String?    @db.VarChar(100)
  slug     String?    @unique @db.VarChar(120)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

enum ProductType {
  physical
  digital
}

model Product {
  id                  Int                  @id @default(autoincrement())
  storeId             Int                  @map("store_id")
  categoryId          Int?                 @map("category_id")
  parentSku           String?              @unique @map("parent_sku") @db.VarChar(80)
  name                String               @db.VarChar(255)
  displayName         String?              @map("display_name") @db.VarChar(255)
  slug                String?              @unique @db.VarChar(255)
  description         String?              @db.Text
  productType         ProductType          @default(physical) @map("product_type")
  isActive            Boolean?             @default(true) @map("is_active")
  createdAt           DateTime?            @default(now()) @map("created_at") @db.Timestamp(0)
  store               Store                @relation(fields: [storeId], references: [id])
  category            Category?            @relation(fields: [categoryId], references: [id])
  variants            ProductVariant[]
  images              ProductImage[]
  marketplaceListings MarketplaceListing[]

  @@map("products")
}

model ProductVariant {
  id            Int           @id @default(autoincrement())
  productId     Int           @map("product_id")
  sku           String        @unique @db.VarChar(80)
  variationName String?       @map("variation_name") @db.VarChar(150)
  price         Decimal?      @db.Decimal(10, 2)
  specialPrice  Decimal?      @map("special_price") @db.Decimal(10, 2)
  weightG       Int?          @map("weight_g")
  // Pack sizes offered as quick-pick quantity buttons, e.g. [3, 5, 10]. Stock and prices stay per piece.
  quickQtys     Json?         @map("quick_qtys")
  product       Product       @relation(fields: [productId], references: [id])
  inventory     Inventory?
  orderItems    OrderItem[]
  platformSkus  PlatformSku[]
  priceTiers    PriceTier[]
  purchaseLines PurchaseOrderLine[]
  stockMovements StockMovement[]

  @@map("product_variants")
}

// Per-piece price from min_qty pieces up; below the first tier the variant's own price applies.
// Loaded by scripts/price-tiers.js, applied by src/pricing.js.
model PriceTier {
  id        Int            @id @default(autoincrement())
  variantId Int            @map("variant_id")
  minQty    Int            @map("min_qty")
  unitPrice Decimal        @map("unit_price") @db.Decimal(10, 2)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQty])
  @@map("price_tiers")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int?     @map("product_id")
  // No FK on variant_id in the draft schema, so this stays a plain column.
  variantId Int?     @map("variant_id")
  url       String?  @db.VarChar(500)
  sortOrder Int?     @default(0) @map("sort_order")
  product   Product? @relation(fields: [productId], references: [id])

  @@map("product_images")
}

enum MarketplacePlatform {
  shopee
  lazada
  tiktok
}

// Marketplace links for the "Buy where you like" strip, plus IDs for sync
model MarketplaceListing {
  id             Int                 @id @default(autoincrement())
  productId      Int                 @map("product_id")
  platform       MarketplacePlatform
  externalItemId String?             @map("external_item_id") @db.VarChar(50)
  url            String?             @db.VarChar(500)
  product        Product             @relation(fields: [productId], references: [id])

  @@unique([productId, platform])
  @@map("marketplace_listings")
}

// Single source of truth for stock on the site; refreshed from BigSeller
model Inventory {
  variantId    Int            @id @map("variant_id")
  available    Int            @default(0)
  reserved     Int            @default(0)
  safetyBuffer Int            @default(1) @map("safety_buffer")
  syncedAt     DateTime?      @map("synced_at") @db.Timestamp(0)
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@map("inventory")
}

model Customer {
  id           Int       @id @default(autoincrement())
  email        String?   @unique @db.VarChar(255)
  name         String?   @db.VarChar(150)
  phone        String?   @db.VarChar(30)
  passwordHash   String?   @map("password_hash") @db.VarChar(255)
  sessionVersion Int       @default(0) @map("session_version")
  addressLine    String?   @map("address_line") @db.VarChar(300)
  postcode       String?   @db.VarChar(10)
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(50)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamp(0)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  orders         Order[]

  @@map("customers")
}

enum OrderStatus {
  pending_payment
  paid
  sent_to_bigseller
  shipped
  completed
  cancelled
  refunded
}

model Order {
  id               Int          @id @default(autoincrement())
  orderNo          String?      @unique @map("order_no") @db.VarChar(30)
  customerId       Int?         @map("customer_id")
  // Guest checkout: the buyer's email lives on the order (used with order_no for lookups).
  email            String?      @db.VarChar(255)
  status           OrderStatus? @default(pending_payment)
  subtotal         Decimal?     @db.Decimal(10, 2)
  voucherCode      String?      @map("voucher_code") @db.VarChar(40)
  discount         Decimal?     @default(0) @db.Decimal(10, 2)
  shippingFee      Decimal?     @map("shipping_fee") @db.Decimal(10, 2)
  total            Decimal?     @db.Decimal(10, 2)
  shipName         String?      @map("ship_name") @db.VarChar(150)
  shipPhone        String?      @map("ship_phone") @db.VarChar(30)
  shipAddress      String?      @map("ship_address") @db.Text
  shipPostcode     String?      @map("ship_postcode") @db.VarChar(10)
  shipCity         String?      @map("ship_city") @db.VarChar(100)
  shipState        String?      @map("ship_state") @db.VarChar(50)
  companyName      String?      @map("company_name") @db.VarChar(150)
  note             String?      @db.Text
  courier          String?      @db.VarChar(50)
  trackingNo       String?      @map("tracking_no") @db.VarChar(80)
  bigsellerOrderId String?      @unique @map("bigseller_order_id") @db.VarChar(80)
  createdAt        DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  // Unpaid orders hold a stock reservation until this time (see src/orders.js).
  expiresAt        DateTime?    @map("expires_at") @db.Timestamp(0)
  paidAt           DateTime?    @map("paid_at") @db.Timestamp(0)
  shippedAt        DateTime?    @map("shipped_at") @db.Timestamp(0)
  completedAt      DateTime?    @map("completed_at") @db.Timestamp(0)
  customer         Customer?    @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  stockMovements   StockMovement[]

  @@index([status, expiresAt])
  @@index([customerId, id])
  @@map("orders")
}

model OrderItem {
  id            Int             @id @default(autoincrement())
  orderId       Int?            @map("order_id")
  variantId     Int?            @map("variant_id")
  qty           Int?
  unitPrice     Decimal?        @map("unit_price") @db.Decimal(10, 2)
  customization Json?
  order         Order?          @relation(fields: [orderId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id          Int       @id @default(autoincrement())
  orderId     Int?      @map("order_id")
  provider    String?   @db.VarChar(30)
  providerRef String?   @unique @map("provider_ref") @db.VarChar(100)
  method      String?   @db.VarChar(30)
  amount      Decimal?  @db.Decimal(10, 2)
  status      String?   @db.VarChar(20)
  rawWebhook  Json?     @map("raw_webhook")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  order       Order?    @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// Use-case wizard
model UseCase {
  id              Int     @id @default(autoincrement())
  title           String? @db.VarChar(150)
  description     String? @db.Text
  recommendedChip String? @map("recommended_chip") @db.VarChar(60)
  reason          String? @db.Text

  @@map("use_cases")
}

// No FKs in the draft schema, so both sides stay plain columns.
model UseCaseProduct {
  useCaseId Int @map("use_case_id")
  productId Int @map("product_id")

  @@id([useCaseId, productId])
  @@map("use_case_products")
}

// Phase 3: hosted tap pages
model Tag {
  id         Int       @id @default(autoincrement())
  shortCode  String?   @unique @map("short_code") @db.VarChar(12)
  customerId Int?      @map("customer_id")
  targetUrl  String?   @map("target_url") @db.VarChar(500)
  pageJson   Json?     @map("page_json")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("tags")
}

model TapEvent {
  id        BigInt    @id @default(autoincrement())
  tagId     Int?      @map("tag_id")
  tappedAt  DateTime? @default(now()) @map("tapped_at") @db.Timestamp(0)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  country   String?   @db.VarChar(2)

  @@index([tagId, tappedAt])
  @@map("tap_events")
}

enum SkuPlatform {
  shopee
  lazada
}

enum SkuMatchMethod {
  exact
  prefix_rule
  manual
}

// Cross-platform SKU mapping (Lazada SKUs often carry pack prefixes, e.g. wholesale3_black_nfcntag215 -> nfcntag215)
model PlatformSku {
  id             Int             @id @default(autoincrement())
  variantId      Int             @map("variant_id")
  platform       SkuPlatform
  platformSku    String          @map("platform_sku") @db.VarChar(120)
  externalItemId String?         @map("external_item_id") @db.VarChar(50)
  packQty        Int             @default(1) @map("pack_qty")
  matchMethod    SkuMatchMethod? @default(exact) @map("match_method")
  needsReview    Boolean?        @default(false) @map("needs_review")
  variant        ProductVariant  @relation(fields: [variantId], references: [id])

  @@unique([platform, platformSku])
  @@map("platform_skus")
}

enum PurchaseOrderStatus {
  draft
  ordered
  received
  cancelled
}

model PurchaseOrder {
  id         Int                 @id @default(autoincrement())
  poNumber   String              @unique @map("po_number") @db.VarChar(30)
  supplier   String              @db.VarChar(150)
  orderDate  DateTime            @map("order_date") @db.Date
  status     PurchaseOrderStatus @default(draft)
  notes      String?             @db.Text
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  receivedAt DateTime?           @map("received_at") @db.Timestamp(0)
  lines      PurchaseOrderLine[]

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              Int             @id @default(autoincrement())
  purchaseOrderId Int             @map("purchase_order_id")
  variantId       Int?            @map("variant_id")
  sku             String?         @db.VarChar(80)
  description     String          @db.VarChar(255)
  qty             Int
  unitCost        Decimal         @map("unit_cost") @db.Decimal(10, 2)
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("purchase_order_lines")
}

model Setting {
  key       String   @id @db.VarChar(60)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("settings")
}

enum VoucherType {
  percent
  fixed
}

model Voucher {
  id         Int         @id @default(autoincrement())
  code       String      @unique @db.VarChar(40)
  type       VoucherType
  value      Decimal     @db.Decimal(10, 2)
  minSpend   Decimal?    @map("min_spend") @db.Decimal(10, 2)
  active     Boolean     @default(true)
  startsAt   DateTime?   @map("starts_at") @db.Timestamp(0)
  expiresAt  DateTime?   @map("expires_at") @db.Timestamp(0)
  usageLimit Int?        @map("usage_limit")
  usedCount  Int         @default(0) @map("used_count")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("vouchers")
}

model StockMovement {
  id        Int            @id @default(autoincrement())
  variantId Int            @map("variant_id")
  delta     Int
  reason    String         @db.VarChar(20)
  orderId   Int?           @map("order_id")
  note      String?        @db.VarChar(255)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}
