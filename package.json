{
  "name": "wyr-website",
  "private": true,
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "concurrently -n server,client -c blue,magenta \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm run dev -w server",
    "server:start": "npm run start -w server",
    "client:dev": "npm run dev -w client",
    "client:build": "npm run build -w client",
    "install-all": "npm install",
    "dev": "npm start",
    "build": "npm run build -w server && npm run build -w client",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma",
    "import:catalog": "npm run import:catalog -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
